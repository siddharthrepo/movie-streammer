CATALOG_SERVICE_PORT=8081
GIN_MODE=debug
SHUTDOWN_TIMEOUT_SECONDS=15

MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=movie
MYSQL_PASSWORD=movie
MYSQL_DATABASE=movie_streamer

MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME_MINUTES=30

LOG_LEVEL=info
LOG_FORMAT=console
SLOW_QUERY_THRESHOLD_MS=200

S3_REGION=us-east-1
S3_BUCKET=movie-streamer-media
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=
UPLOAD_PART_SIZE_BYTES=67108864
UPLOAD_PRESIGN_TTL_SECONDS=3600

FFPROBE_BINARY=ffprobe
PROBE_TIMEOUT_SECONDS=120

WORKER_CONCURRENCY=3
WORKER_BATCH_SIZE=1
WORKER_POLL_INTERVAL_MS=500
WORKER_IDLE_BACKOFF_MS=3000
WORKER_MAX_ATTEMPTS=3

LEASE_TTL_SECONDS=60
LEASE_RENEW_INTERVAL_SECONDS=20
LEASE_RECLAIM_GRACE_SECONDS=5
