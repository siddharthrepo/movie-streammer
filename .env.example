# Copy to .env and adjust. .env is gitignored. This file documents every key.

# --- upload-service ---
UPLOAD_SERVICE_PORT=8080

# --- Postgres (metadata DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=movie
POSTGRES_PASSWORD=movie
POSTGRES_DB=movie_streamer
POSTGRES_SSLMODE=disable

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=movies

# --- RabbitMQ (job broker) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- transcode ---
# Max attempts per chunk before it is marked dead (ADR-009). Default 3 if unset.
TRANSCODE_MAX_ATTEMPTS=3
